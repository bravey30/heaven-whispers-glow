# Supabase (Settings → API in your Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMTP (used to send booking notifications/confirmations — e.g. a Gmail
# address with a generated "App Password", or any other mailbox's SMTP details)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Heaven Aesthetics <no-reply@example.com>"

# Where new-appointment notifications are sent. Defaults to SMTP_USER if unset.
ADMIN_EMAIL=

# Shared password that unlocks /admin
ADMIN_PASSWORD=

# Random string used to encrypt/sign the admin session cookie — must be at
# least 32 characters. Generate one with: openssl rand -base64 32
SESSION_SECRET=
